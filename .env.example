# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DIRECT_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# PesaPal (M-Pesa + Cards + Bank)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_ID=your-pesapal-ipn-id

# Site
NEXT_PUBLIC_SITE_URL=https://touchgiftshop.co.ke

# Rider & Admin API Keys (generate with: node -e "console.log('tg_rider_'+require('crypto').randomBytes(24).toString('hex'))")
RIDER_API_KEY=your-rider-api-key
ADMIN_API_KEY=your-admin-api-key
ADMIN_ALLOWED_IPS=

# AI Providers (at least one required for T-Gifter chat)
OPENROUTER_API_KEY=your-openrouter-key
OPENAI_API_KEY=your-openai-key
GROK_API_KEY=your-grok-key
GEMINI_API_KEY=your-gemini-key

# Ollama (local AI fallback — optional, only needed if running Ollama locally)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_FALLBACK_MODELS=

# LibreTranslate (optional — for multi-language chat)
LIBRETRANSLATE_URL=http://localhost:5000

# ── Corporate ops notifications (roadmap Phase 1.2) ──────────────────────────
# Inbox that receives a notification for every new corporate quote. Without it
# the quote still saves to the DB — the dashboard simply doesn't get pinged.
NOTIFY_EMAIL=ops@touchgiftshop.co.ke

# Used by lib/notifications.ts (SendGrid) for the above. sendEmail() soft-fails
# with reason "sendgrid_not_configured" when these are blank.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=TouchGift Corporate <noreply@touchgiftshop.co.ke>

# NOTE: app/api/corporate/bulk-inquiry sends via Resend instead, so both mail
# stacks currently coexist. Unifying them is tracked as Phase 1 cleanup.

# Ops WhatsApp desk — target for the dashboard's "copy WhatsApp deep link"
# when the customer gave no phone number. Public (NEXT_PUBLIC_) because it is
# rendered into a client-side link.
NEXT_PUBLIC_OPS_WHATSAPP=254183172111
