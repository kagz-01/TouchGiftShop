# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# M-Pesa via Tuma Payment Gateway (settles to Family Bank)
TUMA_EMAIL=your-tuma-email
TUMA_API_KEY=your-tuma-api-key
TUMA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# WooCommerce (private admin backend)
WOOCOMMERCE_URL=https://admin.touchgift.co.ke
WOOCOMMERCE_CONSUMER_KEY=your-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=your-consumer-secret
WOOCOMMERCE_WEBHOOK_SECRET=your-webhook-secret

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
